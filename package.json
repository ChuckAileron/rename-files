{
  "name": "rename-files",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm:electron-dev\" \"npm:react-start\"",
    "electron-dev": "wait-on http://localhost:39417 && electron .",
    "react-start": "webpack serve --mode development",
    "build:renderer": "webpack --mode production",
  "build:main": "tsc src/main.ts src/preload.ts --outDir dist --esModuleInterop --module commonjs --target ES2021",
    "electron": "electron .",
    "lint": "eslint 'src/**/*.{ts,tsx}' --fix",
    "build": "npm run build:renderer && npm run build:main"
  },
  "dependencies": {
    "electron": "^29.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "html-webpack-plugin": "^5.6.4",
    "prettier": "^3.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.1",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
